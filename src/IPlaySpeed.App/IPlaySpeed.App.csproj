<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows.Media.Control(SMTC)·레지스트리 등 WinRT/Win32 API를 쓰기 위해
         Windows 10 SDK 버전을 명시한 TFM 사용. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms> <!-- 시스템 트레이(NotifyIcon)용 -->
    <RootNamespace>IPlaySpeed.App</RootNamespace>
    <AssemblyName>iPlaySpeed</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF가 manifest로 DPI를 설정하므로 WinForms의 DPI 경고는 무시(트레이만 사용) -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- assets\app.ico 가 있으면 실행 파일(.exe) 아이콘으로 사용 -->
    <ApplicationIcon Condition="Exists('assets\app.ico')">assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Microsoft.Win32.Registry 는 net8.0-windows TFM에 기본 포함되어 별도 패키지가 필요 없음 -->

  <!-- UseWindowsForms가 추가하는 암시적 using이 WPF 타입(Brush/Point 등)과 충돌하므로 제거.
       WinForms 타입은 코드에서 정규화(System.Windows.Forms.) 또는 별칭으로만 사용한다. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IPlaySpeed.Core\IPlaySpeed.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 로고를 어셈블리에 임베드(단일 exe로 독립 실행 — 외부 파일 불필요). pack URI로 로드. -->
    <Resource Include="assets\app.png" Condition="Exists('assets\app.png')" />
    <Resource Include="assets\app.ico" Condition="Exists('assets\app.ico')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

</Project>
