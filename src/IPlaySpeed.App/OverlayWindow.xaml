<Window x:Class="IPlaySpeed.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iPlaySpeed Overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">

    <Border x:Name="RootBorder" CornerRadius="12" Padding="12,10"
            Background="#E61A1B22" MouseLeftButtonDown="OnDragStart" MouseLeftButtonUp="OnDragEnd">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.5" />
        </Border.Effect>

        <StackPanel>
            <!-- 상단: 현재(또는 다음 대기) 게임 + 컨트롤 -->
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="TxtCurrent" Text="대기 중" Foreground="#EDEDF2" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="2,0,12,0" />
                <Button x:Name="BtnClose" DockPanel.Dock="Right" Content="✕" Click="OnHide"
                        Style="{StaticResource IconButton}" FontSize="13" Margin="4,0,0,0"
                        ToolTip="오버레이 숨기기 (단축키로 다시 켜기)" />
                <Button x:Name="BtnMin" DockPanel.Dock="Right" Content="—" Click="OnToggleMinimize"
                        Style="{StaticResource IconButton}" FontSize="14" Margin="4,0,0,0"
                        ToolTip="축소 / 복원" />
                <Button x:Name="BtnNext" DockPanel.Dock="Right" Content="▶ 다음" Click="OnNext"
                        Style="{StaticResource IconButton}" FontSize="12" Margin="8,0,0,0"
                        ToolTip="현재 게임 종료 후 다음 게임 실행" />
                <TextBlock x:Name="TxtProgress" DockPanel.Dock="Right" Text="0%" Foreground="#39D98A"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0" />
            </DockPanel>

            <!-- 게이지 + 체크포인트 -->
            <Canvas x:Name="GaugeCanvas" Width="360" Height="44" Margin="0,8,0,0" />

            <!-- 멀티미디어 컨트롤 + 출처아이콘 + 제목(마퀴) + 재생시간 -->
            <StackPanel x:Name="MediaPanel" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="⏮" Click="OnMediaPrev" Style="{StaticResource IconButton}" FontSize="14" ToolTip="이전" />
                <Button Content="⏯" Click="OnMediaPlayPause" Style="{StaticResource IconButton}" FontSize="14" Margin="2,0" ToolTip="재생/일시정지" />
                <Button Content="⏭" Click="OnMediaNext" Style="{StaticResource IconButton}" FontSize="14" Margin="0,0,6,0" ToolTip="다음" />
                <Image x:Name="SrcIcon" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                <Border x:Name="MarqueeClip" Width="150" Height="18" ClipToBounds="True" Background="Transparent" VerticalAlignment="Center">
                    <!-- 제목 2개를 Canvas 절대좌표(0, unit)로 두고 묶음을 좌측으로 unit만큼 이동 →
                         끝점에서 두 번째 제목이 처음 위치와 정확히 겹쳐 끊김 없이 순환(좌표=이동량 동일). -->
                    <Canvas x:Name="MarqueeCanvas" Height="18">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="MarqueeTransform" X="0" />
                        </Canvas.RenderTransform>
                        <TextBlock x:Name="TxtMedia" Canvas.Left="0" Canvas.Top="1" Text="재생 중인 미디어 없음" Foreground="#C9CBD6" FontSize="11" />
                        <TextBlock x:Name="TxtMedia2" Canvas.Top="1" Foreground="#C9CBD6" FontSize="11" Visibility="Collapsed" />
                    </Canvas>
                </Border>
                <TextBlock x:Name="TxtTime" Text="" Foreground="#6A6C78" FontSize="11"
                           VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>

            <!-- 볼륨 분리: 게임 / 미디어 앱을 따로 조절 -->
            <StackPanel x:Name="VolumePanel" Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#EDEDF2"
                           VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="게임 볼륨" />
                <Slider x:Name="GameVolume" Width="118" Minimum="0" Maximum="100" IsEnabled="False"
                        SmallChange="5" LargeChange="10" VerticalAlignment="Center"
                        Style="{StaticResource OverlaySlider}"
                        ValueChanged="OnGameVolumeChanged" ToolTip="현재 플레이 중인 게임 볼륨" />
                <TextBlock x:Name="TxtGameVol" Text="--" Width="30" Foreground="#C9CBD6" FontSize="11"
                           TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,14,0" />
                <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#EDEDF2"
                           VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="미디어 볼륨" />
                <Slider x:Name="MediaVolume" Width="118" Minimum="0" Maximum="100" IsEnabled="False"
                        SmallChange="5" LargeChange="10" VerticalAlignment="Center"
                        Style="{StaticResource OverlaySlider}"
                        ValueChanged="OnMediaVolumeChanged" ToolTip="재생 중인 미디어 앱 볼륨" />
                <TextBlock x:Name="TxtMediaVol" Text="--" Width="30" Foreground="#C9CBD6" FontSize="11"
                           TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
